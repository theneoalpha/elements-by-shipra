# Site configuration is static in config/site.ts — no runtime env required.
# Add API keys / service URLs here if a backend is introduced later.

# Sanity Configuration
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Webhook secret for cache revalidation (generate a new one for production)
SANITY_REVALIDATE_SECRET=

# Sanity Token for write operations (create at sanity.io/manage → API → Tokens)
SANITY_TOKEN=

# Email Configuration (Resend)
# Get your API key at https://resend.com
RESEND_API_KEY=
# The email address that will receive inquiries
CONTACT_EMAIL=
# The email address that will send the inquiries (must be verified in Resend, or use onboarding@resend.dev for testing)
SENDER_EMAIL=
